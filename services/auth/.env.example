# ─── ScyllaDB ─────────────────────────────────────────────
SCYLLA_HOSTS=localhost
SCYLLA_PORT=9042
SCYLLA_USERNAME=cassandra
SCYLLA_PASSWORD=cassandra

# ─── Auth Service ─────────────────────────────────────────
AUTH_GRPC_PORT=50051

# ─── JWT & JWKS ───────────────────────────────────────────
# Must be at least 32 characters for HS256 (legacy, not used with EdDSA)
JWT_SECRET=supersecretjwtkey_changethis

# JWKS endpoint served at: http://localhost:50051/.well-known/jwks.json
# Auth service uses Ed25519 asymmetric signing (EdDSA)
# Public keys automatically rotated and available for other services

# Go duration strings: 15m, 1h, 168h etc.
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h
# Keep signing keys longer than refresh tokens so restart does not invalidate
# still-valid tokens signed by older keys.
EDDSA_SIGNING_KEY_RETENTION_DURATION=336h
